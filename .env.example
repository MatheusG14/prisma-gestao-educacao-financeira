# Serviço de e-mail do Prisma (opcional - sistema funciona sem esta configuração)
# Configure apenas se desejar recursos de e-mail (recuperação de senha, envio de PDFs)
EMAIL_PROVIDER=smtp
EMAIL_FROM=seu-email@seu-dominio.com
EMAIL_FROM_NAME=Prisma

# SMTP (opcional)
SMTP_HOST=smtp.seu-dominio.com
SMTP_PORT=587
SMTP_USER=seu-email@seu-dominio.com
SMTP_PASSWORD=sua_senha_aqui
SMTP_SECURE=false
SMTP_TIMEOUT_MS=15000

# Limites de envio de PDFs
PDF_SEND_PER_MINUTE=3
PDF_SEND_PER_DAY=20
PDF_MAX_BYTES=10485760

# Autenticação / sessão
NODE_ENV=development
SESSION_TTL_DAYS=30

# Recuperação de senha reutiliza o SMTP acima (requer SMTP configurado)

# URL pública usada nos links de recuperação de senha
APP_BASE_URL=http://localhost:3000

# Administrador inicial (opcional). O sistema funciona sem administrador.
# Configure apenas se desejar um administrador inicial. Os dados NÃO são persistidos e são perdidos ao reiniciar o servidor.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=sua_senha_aqui
